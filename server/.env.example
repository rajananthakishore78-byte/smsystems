PORT=5000
CLIENT_URL=http://localhost:5173

# PostgreSQL (Supabase) direct connection
# Supabase Dashboard -> Project Settings -> Database -> Connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://postgres:YOUR_DB_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
# Set to false only for a local PostgreSQL server without SSL
DATABASE_SSL=true

# Supabase REST / Storage / Auth credentials (Dashboard -> Project Settings -> API keys)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# Publishable key - safe to expose in browser code
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Secret key - server-side only, never ship this to the client
SUPABASE_SECRET_KEY=sb_secret_xxx
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json

# Admin portal accounts allowed to sign in through Supabase Auth (comma separated)
ADMIN_EMAILS=admin@your-showroom.com

# Cloudinary Configuration (For Product & Banner Images)
# Get these from your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin Configuration (For Admin Authentication)
# Get these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Break-glass admin key for server-side scripts only (used when ADMIN_EMAILS is unavailable)
ADMIN_SECRET_KEY=generate_a_random_48_char_string_here
