PORT=5000
CLIENT_URL=http://localhost:5173

# Supabase (PostgreSQL) Configuration
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Cloudinary Configuration (For Product & Banner Images)
# Get these from your Cloudinary Dashboard
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Firebase Admin Configuration (For Admin Authentication)
# Get these from Firebase Console -> Project Settings -> Service Accounts -> Generate new private key
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Admin Master Passcode (Fallback for quick local admin evaluation)
ADMIN_SECRET_KEY=cctv_admin_secure_2026
